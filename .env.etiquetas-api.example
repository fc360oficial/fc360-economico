# etiquetas-api.js — variáveis de ambiente (copiar para .env.etiquetas-api e preencher)
PORT=3011
DB_HOST=192.168.2.254
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json
# Origem(ns) permitida(s) para CORS — deve ser a URL real onde o FC360 PWA
# está publicado em produção (ex.: https://fc360oficial.github.io). Aceita
# múltiplas origens separadas por vírgula. NUNCA deixar em branco/'*' pois
# este endpoint é autenticado.
ALLOWED_ORIGIN=https://fc360oficial.github.io
